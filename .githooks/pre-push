#!/bin/sh

# Warn, never block, when records/STATUS.md is stale relative to the commits
# being pushed. Stale truth docs are how the Needs Work pile forms.

status_file="records/STATUS.md"

[ -f "$status_file" ] || exit 0

zero="0000000000000000000000000000000000000000"

while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_oid" = "$zero" ] && continue
  range="$remote_oid..$local_oid"
  [ "$remote_oid" = "$zero" ] && range="$local_oid"
  total=$(git rev-list --count "$range" 2>/dev/null || echo 0)
  [ "$total" -gt 0 ] 2>/dev/null || continue
  touched=$(git rev-list --count "$range" -- "$status_file" 2>/dev/null || echo 0)
  if [ "$total" -ge 10 ] && [ "$touched" -eq 0 ]; then
    echo "repo-template note: $total commits pushed without touching $status_file." >&2
    echo "  If operational truth changed, update the snapshot before it drifts." >&2
  fi
done

exit 0
